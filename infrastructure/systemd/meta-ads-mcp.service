[Unit]
Description=Meta Ads MCP Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/ads-mcp
ExecStart=/opt/ads-mcp/.venv/bin/python servers/meta-ads/main.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/ads-mcp/meta-ads.log
StandardError=append:/var/log/ads-mcp/meta-ads.log
Environment=PYTHONUNBUFFERED=1
Environment=AWS_REGION=us-east-1
Environment=ADS_MCP_REQUIRE_SIGNED_REQUESTS=true
Environment=ADS_MCP_MEDIA_BUCKET=amz-s3-videos-ads-mcp-009959434008-us-east-1-an

[Install]
WantedBy=multi-user.target
